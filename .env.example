NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT=

# Administrator bootstrap — server-only, never trusted from the browser.
# The Supabase account with this verified email is granted the `owner`
# role (and an enabled AI entitlement) the first time it authenticates.
# See src/lib/admin/roles.ts. Not a runtime authorization check on every
# request — once bootstrapped, ownership lives in app_user_roles.
APP_OWNER_EMAIL=owner@example.com

# AI job description parser (OpenAI gpt-5-mini, single-model strategy) —
# server-only, never exposed to the client. Access is controlled per-user
# via the ai_parser_entitlements table (managed from Settings ->
# Administration), not a hard-coded email allowlist.
OPENAI_API_KEY=
AI_PARSER_MODEL=gpt-5-mini
AI_PARSER_REASONING_EFFORT=low
AI_PARSER_MAX_RETRIES=1
AI_PARSER_MAX_INPUT_CHARS=50000
# Defaults applied when a user's entitlement doesn't set its own limit.
AI_PARSER_DEFAULT_DAILY_LIMIT=100
AI_PARSER_DEFAULT_MONTHLY_BUDGET_USD=5
AI_PARSER_MINUTE_LIMIT=5
AI_PARSER_CONCURRENCY_LIMIT=2
