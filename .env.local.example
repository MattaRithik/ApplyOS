# =====================================================================
# Public — safe to expose to the browser (Next.js inlines these at build
# time). ONLY these two may ever be prefixed with NEXT_PUBLIC_.
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =====================================================================
# Server-only secrets — NEVER prefix with NEXT_PUBLIC_. These are read
# only in Server Components, Server Actions, and API routes, and are
# never bundled into client JavaScript.
# =====================================================================

# Supabase service role key. Not currently required by any route (every
# resume/data operation runs under the signed-in user's RLS-scoped
# session), but kept available for future privileged server-side jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backblaze B2 (S3-compatible API) — stores resume files. Supabase Postgres
# stores only resume metadata + the B2 object key, never the file itself
# and never a public URL. See README.md for how to create the bucket and
# a restricted application key scoped to it.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT=

# Optional: enables LLM-backed job description parsing in
# src/app/api/parser/route.ts. Without it, ApplyOS falls back to the
# built-in heuristic/regex parser (still fully functional).
ANTHROPIC_API_KEY=
